<Page x:Class="ShoeStoreApp.Pages.ProductList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStoreApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список товаров">
    <Page.Resources>
        <Style x:Key="ProductItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MainBG}"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="4"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighDicount}" Value="True">
                    <Setter Property="Background" Value="#2E8B57"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" x:Name="HeadPanel" Orientation="Horizontal" Visibility="Collapsed">
            <StackPanel Orientation="Vertical" Margin="10,5,10,0">
                <TextBlock Text="Поиск:"/>
                <TextBox x:Name="tbFind" Width="100" Height="20" TextChanged="tbFind_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5,10,0">
                <TextBlock Text="Сортировка:"/>
                <ComboBox x:Name="cmbSort" Width="100" Height="20" SelectionChanged="cmbSort_SelectionChanged">
                    <ComboBoxItem Content="Количество по возр."/>
                    <ComboBoxItem Content="Количество по уб."/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                <TextBlock Text="Фильтр:"/>
                <ComboBox x:Name="cmbFilter" Width="100" Height="20" SelectionChanged="cmbFilter_SelectionChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="300, 5,0,0" x:Name="btnPanel">
                <Button x:Name="btnOrders" Visibility="Collapsed" Content="Заказы" Background="{StaticResource AccesBG}" Height="25" Click="btnOrders_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnAdd" Visibility="Collapsed" Content="Добавить" Background="{StaticResource AccesBG}" Height="25" Click="btnAdd_Click"/>
            </StackPanel>

        </StackPanel>
        <ListBox Grid.Row="1" x:Name="lbProducts" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="lbProducts_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ProductItemStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Height="120" Width="140" Stretch="Uniform" Source="{Binding ImagePath}"/>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Categories.CategoryName}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text=" | " FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="15"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Производитель: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Producers.ProducerName}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Поставщик: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Suppliers.SupplierName}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Единица измерения: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Units.UnitName}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Количество на складе: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Count}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Цена: " FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOldPrice" Text="{Binding Price, StringFormat={}{0:N2} руб.}" Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,10,0"  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtActualPrice" Text="{Binding ActualPrice, StringFormat={}{0:N2} руб.}" Foreground="Black" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Действующая" HorizontalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="скидка" HorizontalAlignment="Center" FontSize="11"/>
                                <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
