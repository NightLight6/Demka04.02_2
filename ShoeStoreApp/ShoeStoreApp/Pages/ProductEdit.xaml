<Page x:Class="ShoeStoreApp.Pages.ProductEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStoreApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
Title="ProductEdit">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Width="200">
                <Image x:Name="imgProduct" Source="/Icon.png" Grid.Column="1" Width="125" Height="125" Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBlock Text="Артикул:"/>
                <TextBox x:Name="txbArticul" Margin="0,0,0,10"/>
                <TextBlock Text="Название:"/>
                <TextBox x:Name="txbProductName" Margin="0,0,0,10"/>
                <TextBlock Text="Единица измерения:"/>
                <ComboBox x:Name="cmbUnits" Margin="0,0,0,10"/>
                <TextBlock Text="Цена:"/>
                <TextBox x:Name="txbPrice" Margin="0,0,0,10"/>
                <TextBlock Text="Поставщик:"/>
                <ComboBox x:Name="cmbSupplier" Margin="0,0,0,10"/>
                <TextBlock Text="Производитель:"/>
                <ComboBox x:Name="cmbProducer" Margin="0,0,0,10"/>
                <TextBlock Text="Категория:"/>
                <ComboBox x:Name="cmbCategory" Margin="0,0,0,10"/>
                <TextBlock Text="Скидка:"/>
                <TextBox x:Name="txbDiscount" Margin="0,0,0,10"/>
                <TextBlock Text="Кол-во на складе:"/>
                <TextBox x:Name="txbCount" Margin="0,0,0,10"/>
                <TextBlock Text="Описание:"/>
                <TextBox x:Name="txbDescription" Margin="0,0,0,10"/>
                <Button x:Name="btnEditImage" Content="Изменить картинку" Height="30" Width="95" Click="btnEditImage_Click" Background="{StaticResource AccesBG}" Margin="0,0,10,10"/>
                <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,0,50">
                    <Button x:Name="btnSave" Content="Сохранить" Height="30" Width="95" Click="btnSave_Click" Background="{StaticResource AccesBG}" Margin="0,0,10,0"/>
                    <Button x:Name="btnDelete" Content="Удалить" Height="30" Width="95" Background="{StaticResource AccesBG}" Click="btnDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
