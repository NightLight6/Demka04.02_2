<Page x:Class="ShoeStoreApp.Pages.OrderList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStoreApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
    Title="OrderList">
    <Page.Resources>
        <Style x:Key="ProductItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MainBG}"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
            <Button Visibility="Collapsed" Content="Изменение" x:Name="btnEdit" Margin="10,0,0,0" Width="50" Click="btnEdit_Click"/>
            <Button Visibility="Collapsed" Content="Добавение" x:Name="btnAdd" Margin="10,0,0,0" Width="50" Click="btnAdd_Click"/>
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="lbOrders" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text = "Артикул заказа: "  FontWeight="Bold"/>
                                <TextBlock x:Name="tbOrderId" Text = "{Binding OrderId}"  FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text = "Статус заказа: "  FontWeight="Bold"/>
                                <TextBlock x:Name="tbOrderStatus" Text = "{Binding OrderStatuses.StatusName}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text = "Адрес пункта выдачи: "  FontWeight="Bold"/>
                                <TextBlock x:Name="tbPointAdress" Text="{Binding PointAdress}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text = "Дата заказа: "  FontWeight="Bold"/>
                                <TextBlock x:Name="tbOrderDS" Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5">
                            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                                <TextBlock Text = "Дата доставки: "  FontWeight="Bold"/>
                                <TextBlock x:Name="tbOrderDE" Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
