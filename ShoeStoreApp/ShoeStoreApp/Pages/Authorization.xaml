<Page x:Class="ShoeStoreApp.Pages.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeStoreApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Authorization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Width="190" Margin="0,150,0,0">
            <TextBlock Text="Логин:" Width="150"/>
            <TextBox x:Name="tbLogin" Margin="0,0,0,10" Width="150"/>
            <TextBlock Text="Пароль:" Width="150"/>
            <PasswordBox x:Name="pbPassword" Width="150"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" >
                <Button x:Name="btnEnter" Content="Войти" Width="90" Height="30" Margin="0,0,10,0" Background="{StaticResource AccesBG}" Click="btnEnter_Click"/>
                <Button x:Name="btnGuest" Content="Войти как гость" Width="90" Height="30" Click="btnGuest_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
